# Copy to .env (next to server.js) and adjust. Read by deploy/start.sh.
PORT=8080
HOST=0.0.0.0
# Where the database and downloaded/uploaded media live. Back this folder up.
DATA_DIR=./data
MAX_UPLOAD_MB=500
# Optional search sources (Audius and Archive.org work without keys)
# JAMENDO_CLIENT_ID=
# YOUTUBE_API_KEY=
# Allow links to LAN addresses such as a NAS (off by default to prevent server-side request forgery)
# ALLOW_PRIVATE_URLS=1
